# ============================================================
# LLM Firewall — environment configuration example.
# Copy to .env and edit. NEVER commit a populated .env.
# ============================================================

# --- Runtime ---
FIREWALL_ENV=dev                    # dev | staging | prod
FIREWALL_HOST=0.0.0.0
FIREWALL_PORT=8080
FIREWALL_LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR

# --- TLS / reverse-proxy acknowledgement ---
# In prod, service refuses to start unless TRUST_PROXY=true.
# This forces an explicit acknowledgement that a TLS-terminating proxy is in front.
TRUST_PROXY=false

# --- Authentication ---
# Newline-separated OR ';;'-separated list of Argon2id-hashed API keys.
# (Argon2 hashes contain commas internally, so comma cannot be the delimiter.)
# Generate with: python -m firewall.api.auth hash <plaintext-key>
FIREWALL_API_KEYS_HASHED=

# --- Claude upstream ---
ANTHROPIC_API_KEY=                  # required for /v1/proxy
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_TIMEOUT_S=30

# --- Detection thresholds ---
BLOCK_THRESHOLD=0.80
WARN_THRESHOLD=0.50
BLOCKING_MODE=hard_block            # hard_block | soft_warn | shadow

# --- Classifier ---
CLASSIFIER_MODEL_PATH=./models/artifact
CLASSIFIER_MODEL_SHA256=            # optional pin; empty disables check
CLASSIFIER_MAX_TOKENS=512
CLASSIFIER_TIMEOUT_MS=2000
CLASSIFIER_DEVICE=cpu               # cpu | cuda

# --- Rate limiting ---
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40

# --- Input validation ---
MAX_PROMPT_BYTES=32768              # 32 KB
MAX_PROMPT_CHARS=16384

# --- Logging ---
LOG_FULL_PROMPTS=false              # PII-sensitive; opt-in only
LOG_FULL_PROMPT_TTL_DAYS=7          # ignored unless LOG_FULL_PROMPTS=true

# --- Debug ---
DEBUG_TIMING=false                  # expose per-layer latency in verdicts
